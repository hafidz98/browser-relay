<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#8B72F0</color>

    <!-- The dark theme of the web client (shell/assets/client/index.html :root).
         The Android client reads the same palette so the two look like
         one product. -->
    <color name="relay_bg">#0B0B0B</color>
    <color name="relay_panel">#1E1E1E</color>
    <color name="relay_raised">#262626</color>
    <color name="relay_active">#2F2F2F</color>
    <color name="relay_border">#303030</color>
    <color name="relay_text">#DADADA</color>
    <color name="relay_muted">#A2A2A2</color>
    <color name="relay_faint">#8A8A8A</color>
    <color name="relay_accent">#8B72F0</color>
    <color name="relay_green">#3FB950</color>
    <color name="relay_yellow">#D29922</color>
    <color name="relay_red">#F85149</color>
    <color name="relay_field">#141414</color>
    <color name="relay_chip">#B8141414</color>

    <!-- The scrims over the remote view. -->
    <color name="relay_scrim">#40000000</color>
    <color name="relay_scrim_strong">#D8000000</color>

    <!-- White: the text and the icons on an accent button. -->
    <color name="relay_on_accent">#FFFFFF</color>

    <!-- The sheet: the grip line (the web client's sheet-line colour,
         a little brighter so it reads on a phone) and the hairline
         that separates the scrolling body from the pinned actions. -->
    <color name="relay_sheet_line">#5A5A5A</color>
    <color name="relay_sheet_border">#3D3D3D</color>

    <!-- The active tab pill: the accent at 16% with a 55% border. -->
    <color name="relay_accent_soft">#298B72F0</color>
    <color name="relay_accent_line">#8C8B72F0</color>

    <!-- The danger button: a dark red hairline. -->
    <color name="relay_danger_line">#4A2A2A</color>
</resources>
