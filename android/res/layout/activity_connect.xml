<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/relay_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Browser Relay"
        android:textColor="@color/relay_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:text="Connect to the panel on the laptop"
        android:textColor="@color/relay_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server (host:port)"
        android:textColor="@color/relay_faint"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/hostInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:hint="192.168.1.10:8080"
        android:textColor="@color/relay_text"
        android:textColorHint="@color/relay_faint"
        android:inputType="textUri"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pairing code (6 digits)"
        android:textColor="@color/relay_faint"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/tokenInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="22dp"
        android:hint="······"
        android:textColor="@color/relay_text"
        android:textColorHint="@color/relay_faint"
        android:inputType="number"
        android:maxLength="6"
        android:singleLine="true" />

    <Button
        android:id="@+id/connectBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/relay_on_accent"
        android:backgroundTint="@color/relay_accent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="or scan the pairing QR from the laptop panel — the app opens automatically."
        android:textColor="@color/relay_faint"
        android:textSize="12sp"
        android:gravity="center" />

</LinearLayout>
