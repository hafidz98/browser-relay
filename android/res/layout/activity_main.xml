<?xml version="1.0" encoding="utf-8"?>
<!--
    The remote screen is the main surface and fills the window.
    Everything else is one of three states, and only one is on screen:
      - not connected : the connect card (address, code, Connect, reason)
      - connected     : the remote view + a slim status bar
      - lost          : the remote view + the status bar + a Reconnect banner
    The web client does the same: on a phone #screen sits under the
    slim #status bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/relay_bg">

    <!-- the status bar and the remote screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===================== CONNECTED: the status bar =====================
             One place for the state, the round-trip time, and Take over. -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@color/relay_bg"
            android:visibility="gone">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Connected"
                android:textColor="@color/relay_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/latencyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="— ms"
                android:textColor="@color/relay_faint"
                android:textSize="12sp" />

            <Button
                android:id="@+id/takeoverBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Take over"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/relay_accent"
                android:background="@drawable/accent_pill_bg"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===================== THE REMOTE SCREEN ===================== -->
        <FrameLayout
            android:id="@+id/screenArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- fullscreen remote viewport -->
            <com.hafidz.browserrelay.FrameView
                android:id="@+id/frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- "Chrome isn't running" overlay, driven by welcome/status -->
            <LinearLayout
                android:id="@+id/browserDown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:background="@color/relay_scrim_strong"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chrome isn't running on the laptop"
                    android:textColor="@color/relay_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Start it from here — the screen appears as soon as Chrome connects."
                    android:textColor="@color/relay_muted"
                    android:textSize="13sp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/launchChromeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:text="Launch Chrome"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/relay_accent" />
            </LinearLayout>

            <!-- The banners live in one column, so they stack instead of
                 landing on top of each other. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp">

                <!-- CONNECTION LOST: one banner with a Reconnect button. -->
                <LinearLayout
                    android:id="@+id/lostBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/banner_bg"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/lostText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="The connection to the PC was lost."
                        android:textColor="@color/relay_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/reconnectBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Reconnect"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/relay_accent" />
                </LinearLayout>

                <!-- the relay's own notes: the page is frozen, Chrome runs
                     without the flags, another device is driving -->
                <TextView
                    android:id="@+id/statusBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:padding="9dp"
                    android:background="@drawable/banner_bg"
                    android:textColor="@color/relay_text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- first-run hint bubble -->
            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="20dp"
                android:maxWidth="250dp"
                android:padding="9dp"
                android:background="@drawable/hint_bg"
                android:text="The web view is fullscreen and clean.\nThe small handle on the right edge opens the tools — tap: a round button appears, tap again: the tools open.\nTap the screen = the button hides again.\nHold &amp; drag to move its position."
                android:textColor="@color/relay_text"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===================== NOT CONNECTED: the connect card =====================
         The one card the user sees before there is a connection: the PC
         address, the pairing code, one Connect button, and the line under
         it that says what is wrong. -->
    <ScrollView
        android:id="@+id/connectCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/relay_bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Connect to your PC"
                android:textColor="@color/relay_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Open the panel on the laptop for the address and the 6 digit code."
                android:textColor="@color/relay_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="PC ADDRESS"
                android:textColor="@color/relay_faint"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="192.168.1.10:8765"
                android:textColor="@color/relay_text"
                android:textColorHint="@color/relay_faint"
                android:background="@drawable/field_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:inputType="textUri"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="PAIRING CODE"
                android:textColor="@color/relay_faint"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="6 digits"
                android:textColor="@color/relay_text"
                android:textColorHint="@color/relay_faint"
                android:background="@drawable/field_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:inputType="number"
                android:maxLength="6"
                android:letterSpacing="0.3"
                android:imeOptions="actionDone"
                android:singleLine="true" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Connect"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/relay_accent" />

            <!-- The line under the button: what is wrong, or what to do.
                 It stays until the next attempt, so it can be read. -->
            <TextView
                android:id="@+id/connectError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="20dp"
                android:textColor="@color/relay_red"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- sheet backdrop -->
    <View
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/relay_scrim"
        android:visibility="gone" />

    <!-- tools bottom sheet -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp"
        android:background="@drawable/sheet_bg"
        android:visibility="invisible">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/grip_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:background="@drawable/url_bg">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_lock" />

                <TextView
                    android:id="@+id/urlText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:text="—"
                    android:textColor="@color/relay_text"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/reloadBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_btn_bg"
                android:src="@drawable/ic_reload"
                android:contentDescription="Reload" />

            <ImageButton
                android:id="@+id/homeBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_btn_bg"
                android:src="@drawable/ic_home"
                android:contentDescription="Shortcuts" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="OPEN TABS"
            android:textColor="@color/relay_faint"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SHORTCUT"
            android:textColor="@color/relay_faint"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <GridLayout
            android:id="@+id/sheetShortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="4" />

        <GridLayout
            android:id="@+id/toolGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="4" />

        <!-- End the session and go back to the connect card. -->
        <Button
            android:id="@+id/disconnectBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Disconnect"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/relay_red"
            android:background="@drawable/danger_btn_bg" />
    </LinearLayout>

    <!-- edge handle sits above everything -->
    <com.hafidz.browserrelay.EdgeHandleView
        android:id="@+id/handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- hidden input for the soft keyboard path -->
    <EditText
        android:id="@+id/kbd"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:textColor="@android:color/transparent"
        android:cursorVisible="false"
        android:inputType="text"
        android:imeOptions="actionNone" />

</FrameLayout>
